#!/sbin/openrc-run

description="Configure IPU6 camera media graph"

depend() {
    need localmount
}

start() {
    ebegin "Configuring IPU6 camera"

    einfo "Configuring CSI2 format"
    media-ctl -d /dev/media0 \
        -V '"Intel IPU6 CSI2 1":0 [fmt:SRGGB10_1X10/1932x1092]' \
        || return 1

    einfo "Configuring V4L2 capture format"
    v4l2-ctl --device=/dev/video8 \
        --set-fmt-video=width=1932,height=1092,pixelformat=BA10 \
        || return 1

    eend 0
}
